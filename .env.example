# SatQuery AI - Environment Configuration
# If you have PostgreSQL configured, set your connection URL below:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/satquery_db

# Optional JWT Secret Key
JWT_SECRET=satquery-geoai-secret-key-2026-secure

# Set to 1 to force mock/CPU mode (automatically enabled if CUDA is unavailable)
# SATQUERY_MOCK=1
